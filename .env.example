# Neon only. Copy to .env.local; never commit actual environment files.
# Next.js and CLI scripts prefer .env.local over .env; process variables win.
# All service credentials stay server-only. Never prefix them with NEXT_PUBLIC_.

# Required: pooled runtime URL and direct migration URL, using the same
# branch/database/owning role/port. Migration scripts write only when invoked.
# URL credentials below are placeholders. Remove channel_binding
# if copied from a libpq template; pg negotiates binding via its driver setting.
DATABASE_URL=postgresql://neondb_owner:replace-with-password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_MIGRATION_URL=postgresql://neondb_owner:replace-with-password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Optional: defaults to verify (strict certificate verification).
# disable is accepted ONLY for loopback development/test PostgreSQL.
DATABASE_SSL=verify
# Optional: integer 1-20, default 3 connections per application instance.
DATABASE_POOL_MAX=3

# Required for file sharing and production preflight: exact branch HTTPS S3
# endpoint, signing region and scoped credential returned by Neon.
# Endpoint shape: https://br-example.storage.c-2.ap-southeast-1.aws.neon.tech
# AWS_REGION must match its suffix, without the Console's aws- prefix.
# token_id -> access key ID; s3_secret_access_key -> secret. Not api_token.
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: private bucket name, default chatbit-attachments. No public bucket.
NEON_STORAGE_BUCKET=chatbit-attachments

# Required in production: at least 32 characters; development has a local default.
# Generate independent secrets with openssl rand -hex 32. Do not reuse credentials.
AUTH_RATE_LIMIT_SECRET=
# Required for GET cleanup scheduling: independent secret of at least 32 characters.
# Alternatively configure ALL three POST secrets below and leave CRON_SECRET empty.
# Send Authorization: Bearer <secret>, never query strings. Configure scheduler
# yourself: calls every minute, attachments every five minutes, maintenance hourly.
CRON_SECRET=

# Required for production preflight/cross-network calling: existing TURN URLs as
# a JSON string array (turn: or turns:). Example: ["turn:relay.example:3478"].
# Shared secret: at least 32 characters, matching your TURN REST-auth configuration.
# Empty defaults permit local STUN-only testing but intentionally FAIL preflight.
CALL_TURN_URLS=[]
CALL_TURN_SHARED_SECRET=

# Optional ICE settings; defaults shown. STUN alone does not ensure reachability.
CALL_STUN_URLS=["stun:stun.l.google.com:19302"]
# Optional 0/1; 1 forces relay-only and requires working TURN.
CALL_RELAY_ONLY=0

# Optional alternative: ALL three independent 32+ character POST cleanup secrets.
# MAINTENANCE_CLEANUP_SECRET=
# ATTACHMENT_CLEANUP_SECRET=
# CALL_CLEANUP_SECRET=

# Optional hosted invalidations. Empty provider keeps PostgreSQL polling only.
# Supported provider: ably. Set ABLY_API_KEY only when explicitly enabling it;
# use the full server-only app.key:secret format. Polling recovery remains enabled.
CHATBIT_REALTIME_PROVIDER=
ABLY_API_KEY=

# Optional numeric/fixed-label server timing diagnostics; disabled unless 1.
# CHATBIT_PERFORMANCE=1

# Isolated tests ONLY; never put these in Vercel or target a live database.
# PostgreSQL suites create schemas, migrate fixtures and write/delete test data.
# TEST_DATABASE_URL=postgresql://test:local-only@127.0.0.1:5432/chatbit_test
# TEST_DATABASE_SSL=disable
# TEST_SECURITY_DATABASE_URL=
# TEST_SECURITY_DATABASE_SSL=disable
# TEST_AUTH_HTTP=1
# CHROME_BIN=/usr/bin/google-chrome
# Optional expanded suite gates (enabled by CI); test servers must be loopback.
# TEST_NEXT_TURBOPACK=1
# TEST_NAVIGATION_BROWSER=1
# TEST_WORKSPACE_BROWSER=1
# TEST_SPA_BROWSER=1
# TEST_SPA_SYNC_ACCEPTANCE=1
# TEST_CALLING_BROWSER=1
# TEST_PUSH_TRANSPORT=1
# TEST_PUSH_BROWSER=1
# CHATBIT_BROWSER_ORIGIN=http://127.0.0.1:3187
# Production theme/outage regression against an intentionally broken LOCAL server:
# TEST_RUNTIME_ORIGIN=http://127.0.0.1:3187
# TEST_RUNTIME_PRODUCTION=1
# TEST_RUNTIME_DATABASE_FAILURE=1
# Further measurement/debug-only switches: docs/environment.md.
# NODE_ENV and VERCEL are supplied by Next.js/hosting, not application secrets.
