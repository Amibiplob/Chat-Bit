# Neon only. Server-side values; never commit actual .env files or credentials.
# Use the same branch/database/owning role in both URLs. Remove channel_binding
# if copied from a libpq template; pg negotiates binding via its driver setting.
DATABASE_URL=postgresql://neondb_owner:replace-with-password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_MIGRATION_URL=postgresql://neondb_owner:replace-with-password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=verify

# Exact production-branch S3 endpoint and scoped credential returned by Neon.
# token_id -> access key ID; s3_secret_access_key -> secret. Not api_token.
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET=chatbit-attachments

# Required: independently generate each secret with openssl rand -hex 32.
AUTH_RATE_LIMIT_SECRET=
# Bearer token for GET on all three cleanup endpoints; configure scheduler yourself.
CRON_SECRET=

# Existing TURN service required for reliable cross-network calls. JSON URL arrays.
CALL_TURN_URLS=[]
CALL_TURN_SHARED_SECRET=

# Optional runtime values; defaults shown.
DATABASE_POOL_MAX=3
CALL_STUN_URLS=["stun:stun.l.google.com:19302"]
CALL_RELAY_ONLY=0

# Optional independent POST cleanup secrets instead of CRON_SECRET GET jobs.
# MAINTENANCE_CLEANUP_SECRET=
# ATTACHMENT_CLEANUP_SECRET=
# CALL_CLEANUP_SECRET=

# Isolated test infrastructure only. Never point these at a live database.
# TEST_DATABASE_URL=postgresql://test:local-only@127.0.0.1:5432/chatbit_test
# TEST_DATABASE_SSL=disable
# TEST_SECURITY_DATABASE_URL=
# TEST_SECURITY_DATABASE_SSL=disable
# TEST_AUTH_HTTP=1
# CHROME_BIN=/usr/bin/google-chrome
