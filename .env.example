# Server-only Neon configuration. Never put actual credentials in source control.
DATABASE_URL=postgresql://neondb_owner:replace-with-password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_MIGRATION_URL=postgresql://neondb_owner:replace-with-password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=verify
DATABASE_POOL_MAX=3

# Required in production: generate independently with openssl rand -hex 32.
# Shared across instances; never use this placeholder in production.
AUTH_RATE_LIMIT_SECRET=

# Optional integration tests; always use a dedicated test database.
TEST_DATABASE_URL=
TEST_DATABASE_SSL=disable

# Exact endpoint/region and scoped storage credential from the production branch.
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET=chatbit-attachments
ATTACHMENT_CLEANUP_SECRET=

# JSON arrays. STUN alone cannot connect all networks; configure TURN for release.
CALL_STUN_URLS=["stun:stun.l.google.com:19302"]
CALL_TURN_URLS=[]
CALL_TURN_SHARED_SECRET=
CALL_RELAY_ONLY=0
CALL_CLEANUP_SECRET=

# Independent 32+ character bearer secrets for external POST cleanup jobs.
MAINTENANCE_CLEANUP_SECRET=
# Optional Vercel GET cron authorization; configure jobs manually (see deployment guide).
CRON_SECRET=
