# PostgreSQL only. No real credentials belong in this file.
# Remove SSL URL parameters; TLS is configured below.
DATABASE_URL=postgresql://chatbit:replace-with-local-password@127.0.0.1:5432/chatbit
# Optional direct endpoint for migrations; defaults to DATABASE_URL.
DATABASE_MIGRATION_URL=
# disable is permitted only on loopback in development. Use verify in production.
DATABASE_SSL=disable
DATABASE_SSL_CA=
DATABASE_POOL_MAX=3

# Required in production: generate independently with openssl rand -hex 32.
# Shared across instances; never use this placeholder in production.
AUTH_RATE_LIMIT_SECRET=

# Optional integration tests; always use a dedicated test database.
TEST_DATABASE_URL=
TEST_DATABASE_SSL=disable
