# Server-only configuration. No real credentials belong in this file.
# Neon: pooled runtime URL; sslmode=require/verify-full retain strict TLS.
# Supabase remains supported. See docs/neon-migration.md before switching.
DATABASE_URL=postgresql://chatbit:replace-with-local-password@127.0.0.1:5432/chatbit
# Direct migration endpoint: required for Neon; optional for other PostgreSQL.
DATABASE_MIGRATION_URL=
# disable is permitted only on loopback in development. Use verify in production.
DATABASE_SSL=disable
DATABASE_SSL_CA=
DATABASE_POOL_MAX=3

# Required in production: generate independently with openssl rand -hex 32.
# Shared across instances; never use this placeholder in production.
AUTH_RATE_LIMIT_SECRET=

# Optional integration tests; always use a dedicated test database.
TEST_DATABASE_URL=
TEST_DATABASE_SSL=disable

# Select exactly one storage provider. Absent defaults to supabase for compatibility.
# Set neon only after database rows AND existing objects have been migrated.
ATTACHMENT_STORAGE_PROVIDER=supabase
# Required only for neon. Obtain from the selected Neon branch; never NEXT_PUBLIC.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional; default matches the existing private bucket.
NEON_STORAGE_BUCKET=chatbit-attachments

# Required only for supabase (also used by the one-time object-copy tool).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=chatbit-attachments
ATTACHMENT_CLEANUP_SECRET=

# JSON arrays. STUN alone cannot connect all networks; configure TURN for release.
CALL_STUN_URLS=["stun:stun.l.google.com:19302"]
CALL_TURN_URLS=[]
CALL_TURN_SHARED_SECRET=
CALL_RELAY_ONLY=0
CALL_CLEANUP_SECRET=

# Independent 32+ character bearer secrets for external POST cleanup jobs.
MAINTENANCE_CLEANUP_SECRET=
# Optional Vercel GET cron authorization; configure jobs manually (see deployment guide).
CRON_SECRET=

# One-time migration only; not needed by Vercel runtime. Direct source/target URLs.
# MIGRATION_SOURCE_DATABASE_URL=
# MIGRATION_TARGET_DATABASE_URL=

# Manual GitHub backup only: repository variable BACKUP_DATABASE_PROVIDER=neon
# and secrets below. Absent provider preserves existing Supabase backup config.
# BACKUP_DATABASE_HOST=
# BACKUP_DATABASE_USER=
# BACKUP_DATABASE_PASSWORD=
# BACKUP_DATABASE_NAME=
# CHATBIT_BACKUP_PASSPHRASE=
# Supabase backup compatibility only (not needed for Neon backups):
# SUPABASE_BACKUP_HOST=
# SUPABASE_BACKUP_USER=
# SUPABASE_BACKUP_PASSWORD=
# SUPABASE_BACKUP_CA=
