generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String   @id @db.Uuid
  username    String   @unique @db.VarChar(30)
  displayName String   @db.VarChar(100)
  avatarUrl   String?
  bio         String?  @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversationMembers ConversationMember[]
  sentMessages        Message[]

  contacts  Contact[] @relation("UserContacts")
  contactOf Contact[] @relation("ContactOwner")

  initiatedCalls Call[] @relation("CallInitiator")

  @@map("profiles")
}

model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  type      ConversationType
  name      String?          @db.VarChar(100)
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
  calls    Call[]

  @@map("conversations")
}

enum ConversationType {
  DIRECT
  GROUP
}

model ConversationMember {
  conversationId String   @db.Uuid
  userId         String   @db.Uuid

  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_members")
}


model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  senderId       String      @db.Uuid

  content String?     @db.Text
  type    MessageType @default(TEXT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  attachments Attachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  SYSTEM
}

model Attachment {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid

  storagePath String
  fileName    String
  fileType    String
  fileSize    Int

  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("attachments")
}

enum ContactStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Contact {
  id String @id @default(uuid()) @db.Uuid

  userId    String @db.Uuid
  contactId String @db.Uuid

  status ContactStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    Profile @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contact Profile @relation("ContactOwner", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId])
  @@index([userId, status])
  @@index([contactId, status])
  @@map("contacts")
}

enum CallType {
  VOICE
  VIDEO
}

enum CallStatus {
  RINGING
  ONGOING
  ENDED
  MISSED
  DECLINED
}

model Call {
  id             String     @id @default(uuid()) @db.Uuid
  conversationId String     @db.Uuid
  initiatedBy    String     @db.Uuid

  type   CallType
  status CallStatus @default(RINGING)

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  initiator   Profile      @relation("CallInitiator", fields: [initiatedBy], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([initiatedBy])
  @@index([status])
  @@map("calls")
}

model CallParticipant {
  callId String @db.Uuid
  userId String @db.Uuid

  joinedAt DateTime?
  leftAt   DateTime?

  call Call    @relation(fields: [callId], references: [id], onDelete: Cascade)
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([callId, userId])
  @@index([userId])
  @@map("call_participants")
}