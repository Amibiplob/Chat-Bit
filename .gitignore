# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results.log
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local credentials and certificates (never remove the local copies)
/certs/
/.aws/
.pgpass
.pg_service.conf
*.key
*.p12
*.pfx

# private database exports and encrypted backup archives
/backups/
*.dump
*.backup
*.sql.gz
*.sql.enc
*.sql.enc.sha256
*.dump.enc
*.dump.enc.sha256
*.tar.enc
*.tar.enc.sha256

# local tool caches
/.cache/
/.pnpm-store/
/.turbo/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
