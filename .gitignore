# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results.log
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local credentials and certificates (never remove the local copies)
/certs/
/certificates/
/credentials/
/secrets/
/.ssh/
id_rsa
id_dsa
id_ecdsa
id_ed25519
/credentials.json
/service-account*.json
/localhost*.crt
/supabase-ca.crt
/.aws/
.pgpass
.pg_service.conf
*.key
*.p12
*.pfx
*.jks
*.keystore
*.keychain

# private database exports and encrypted backup archives
/backups/
*.dump
*.backup
*.sql.gz
*.sql.enc
*.sql.enc.sha256
*.dump.enc
*.dump.enc.sha256
*.tar.enc
*.tar.enc.sha256
*-backup.sql
*.backup.sql
backup.sql
*.sql.bak
*.sql.xz
*.sql.zst
*.dump.gz
/backup/
*-backup.tar*
backup.tar*
*-backup.zip
backup.zip

# local tool caches
/.cache/
/.pnpm-store/
/.turbo/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
*.env
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local logs, scratch files, editors and OS metadata
*.log
*.tmp
*.temp
*.swp
*.swo
*~
/.vscode/
/.idea/
Thumbs.db
Desktop.ini

# Android packaging and generated binaries (source config remains trackable)
/android/generated/
/android/signing/
/android/node_modules/
**/.gradle/
**/local.properties
*.apk
*.aab
*.apks
*.idsig
*.hprof
